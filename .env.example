# =============================================================================
# HIM Product Media · Variables de entorno (PLANTILLA: sin valores reales)
# Copiá a .env (ignorado por git) y cargalas en Supabase con:
#   supabase secrets set --env-file .env
# =============================================================================

# --- Frontend (públicas: pueden ir al navegador) -----------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-o-publishable-key>
VITE_ADOBE_EXPRESS_CLIENT_ID=<client-id-del-embed-sdk>   # pública; restringila por dominio en Adobe Console

# --- Supabase (las inyecta Supabase en las Edge Functions; NO hace falta setearlas) ---
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY

# --- Seguridad de funciones --------------------------------------------------
CRON_SECRET=<openssl rand -hex 32>                       # mismo valor que en Vault (cron_secret)
ALLOWED_ORIGINS=https://tu-dominio.com,http://localhost:5173

# --- Publicador ---------------------------------------------------------------
PUBLISH_BUDGET_MS=110000
PUBLISH_MAX_ATTEMPTS=3

# --- URLs de la app permitidas para volver después de vincular una red ------
# (orígenes separados por coma; el primero es el de respaldo)
APP_URLS=https://tu-dominio.com,http://127.0.0.1:5173
# Opcional: base de los redirect URI (por defecto <SUPABASE_URL>/functions/v1/oauth-callback)
# OAUTH_REDIRECT_BASE=

# --- Instagram (Instagram API con login de Instagram / Business Login) -------
# Redirect URI a registrar: https://<project-ref>.supabase.co/functions/v1/oauth-callback/instagram
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_GRAPH_VERSION=v26.0
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish,instagram_business_manage_insights

# --- TikTok (Login Kit for Web + Content Posting API) ------------------------
# Redirect URI a registrar: https://<project-ref>.supabase.co/functions/v1/oauth-callback/tiktok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_SCOPES=user.info.basic,user.info.profile,video.publish
TIKTOK_PRIVACY_LEVEL=SELF_ONLY                           # PUBLIC_TO_EVERYONE recién tras la auditoría de TikTok

# --- YouTube (Google OAuth 2.0 web + YouTube Data API v3) --------------------
# Redirect URI a registrar: https://<project-ref>.supabase.co/functions/v1/oauth-callback/youtube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.readonly
YOUTUBE_PRIVACY_STATUS=public                            # public | unlisted | private
YOUTUBE_CATEGORY_ID=22

# --- Canva Connect API --------------------------------------------------------
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=https://<project-ref>.supabase.co/functions/v1/oauth-callback/canva

# --- Figma REST API + Webhooks v2 ---------------------------------------------
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=https://<project-ref>.supabase.co/functions/v1/oauth-callback/figma

# --- Video corto (Opus Clip / Descript / CapCut vía automatizador) ------------
# El secreto HMAC de cada usuario se genera por conexión y se guarda cifrado
# en creative_app_connections.webhook_secret_encrypted (no va acá).
OPUS_CLIP_API_KEY=
DESCRIPT_API_TOKEN=

# --- Anthropic Claude ---------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_HOURLY_LIMIT=30

# --- Monitoreo (opcional) -----------------------------------------------------
SENTRY_DSN=
